# HTTP port server lắng nghe.
HTTP_PORT=

# Redis connection string
REDIS_URL=

# JWT secret
JWT_SECRET=

# Log level: debug, info, warn, error
LOG_LEVEL=

# === Cross-instance message bus ===
# Chọn implementation cho broadcast cross-instance.
# false (default) = Redis Pub/Sub (tận dụng Redis có sẵn)
# true = NATS (latency thấp hơn, code đơn giản hơn, cần NATS server)
USE_NATS=

# NATS server URL. Chỉ dùng khi USE_NATS=true.
# Format: nats://[user:pass@]host:port
# Default: nats://localhost:4222
NATS_URL=